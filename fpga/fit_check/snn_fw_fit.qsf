set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U19I7
set_global_assignment -name TOP_LEVEL_ENTITY snn_fw_avmm
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "12:52:42  OCTOBER 13, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"
set_global_assignment -name VERILOG_FILE ../../rtl/sync_fifo.v
set_global_assignment -name VERILOG_FILE ../../rtl/pkt_parser.v
set_global_assignment -name VERILOG_FILE ../../rtl/spike_encoder.v
set_global_assignment -name VERILOG_FILE ../../rtl/snn_core.v
set_global_assignment -name VERILOG_FILE ../../rtl/snn_pkt_filter.v
set_global_assignment -name VERILOG_FILE ../../rtl/snn_fw_avmm.v
set_global_assignment -name SDC_FILE snn_fw_fit.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_instance_assignment -name VIRTUAL_PIN ON -to avs_address*
set_instance_assignment -name VIRTUAL_PIN ON -to avs_write
set_instance_assignment -name VIRTUAL_PIN ON -to avs_writedata*
set_instance_assignment -name VIRTUAL_PIN ON -to avs_read
set_instance_assignment -name VIRTUAL_PIN ON -to avs_readdata*
set_instance_assignment -name VIRTUAL_PIN ON -to avs_waitrequest
set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_location_assignment PIN_Y19 -to leds[0]
set_location_assignment PIN_Y20 -to leds[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to leds[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to leds[1]