; 980.39 MHz ; 650.2 MHz       ; CV96_QSYS:u_cv96_qsys|CV96_QSYS_hps_0:hps_0|CV96_QSYS_hps_0_hps_io:hps_io|CV96_QSYS_hps_0_hps_io_border:border|hps_sdram:hps_sdram_inst|hps_sdram_pll:pll|afi_clk_write_clk ; limit due to minimum period restriction (tmin) ;
