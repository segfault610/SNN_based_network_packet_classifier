       .aclr (1'b0), .apre (1'b0), .srl (1'b0), .srd (1'b0), .q
       (wr_ptr[7]));
  CDN_flop \wr_ptr_reg[8] (.clk (clk), .d (n_52121), .sena (1'b1),
       .aclr (1'b0), .apre (1'b0), .srl (1'b0), .srd (1'b0), .q
       (wr_ptr[8]));
  CDN_flop \wr_ptr_reg[9] (.clk (clk), .d (n_52126), .sena (1'b1),
       .aclr (1'b0), .apre (1'b0), .srl (1'b0), .srd (1'b0), .q
       (wr_ptr[9]));
  CDN_flop \wr_ptr_reg[10] (.clk (clk), .d (n_52131), .sena (1'b1),
       .aclr (1'b0), .apre (1'b0), .srl (1'b0), .srd (1'b0), .q
       (wr_ptr[10]));
  CDN_flop \wr_ptr_reg[11] (.clk (clk), .d (n_52136), .sena (1'b1),
       .aclr (1'b0), .apre (1'b0), .srl (1'b0), .srd (1'b0), .q
       (wr_ptr[11]));
endmodule

module snn_pkt_filter_asic(clk, rst, s_axis_tdata, s_axis_tvalid,
     s_axis_tready, s_axis_tlast, s_axis_tuser, m_axis_tdata,
     m_axis_tvalid, m_axis_tready, m_axis_tlast, m_axis_tuser, cfg_wr,
     cfg_rd, cfg_addr, cfg_wdata, cfg_rdata, verdict_valid,
     verdict_mal);
  input clk, rst, s_axis_tvalid, s_axis_tlast, s_axis_tuser,
       m_axis_tready, cfg_wr, cfg_rd;
  input [7:0] s_axis_tdata;
  input [9:0] cfg_addr;
  input [31:0] cfg_wdata;
  output s_axis_tready, m_axis_tvalid, m_axis_tlast, m_axis_tuser,
       verdict_valid, verdict_mal;
  output [7:0] m_axis_tdata;
  output [31:0] cfg_rdata;
  wire clk, rst, s_axis_tvalid, s_axis_tlast, s_axis_tuser,
       m_axis_tready, cfg_wr, cfg_rd;
  wire [7:0] s_axis_tdata;
  wire [9:0] cfg_addr;
  wire [31:0] cfg_wdata;
  wire s_axis_tready, m_axis_tvalid, m_axis_tlast, m_axis_tuser,
       verdict_valid, verdict_mal;
  wire [7:0] m_axis_tdata;
  wire [31:0] cfg_rdata;
  wire UNCONNECTED20, UNCONNECTED21;
  assign m_axis_tuser = 1'b0;
  assign s_axis_tready = 1'b1;
  snn_pkt_filter_BUF_AW11 u_filter(.clk (clk), .rst (rst),
       .s_axis_tdata (s_axis_tdata), .s_axis_tvalid (s_axis_tvalid),
       .s_axis_tready (UNCONNECTED20), .s_axis_tlast (s_axis_tlast),
       .s_axis_tuser (s_axis_tuser), .m_axis_tdata (m_axis_tdata),
       .m_axis_tvalid (m_axis_tvalid), .m_axis_tready (m_axis_tready),
       .m_axis_tlast (m_axis_tlast), .m_axis_tuser (UNCONNECTED21),
       .cfg_wr (cfg_wr), .cfg_rd (cfg_rd), .cfg_addr (cfg_addr),
       .cfg_wdata (cfg_wdata), .cfg_rdata (cfg_rdata), .verdict_valid
       (verdict_valid), .verdict_mal (verdict_mal));
endmodule

`ifdef RC_CDN_GENERIC_GATE
`else
module CDN_flop(clk, d, sena, aclr, apre, srl, srd, q);
  input clk, d, sena, aclr, apre, srl, srd;
  output q;
  wire clk, d, sena, aclr, apre, srl, srd;
  wire q;
  reg  qi;
  assign #1 q = qi;
  always 
    @(posedge clk or posedge apre or posedge aclr) 
      if (aclr) 
        qi <= 0;
      else if (apre) 
          qi <= 1;
        else if (srl) 
            qi <= srd;
          else begin
            if (sena) 
              qi <= d;
          end
  initial 
    qi <= 1'b0;
endmodule
`endif
