# ---------------------------------------------------------------- Python
.venv/
__pycache__/
*.pyc
data/
*.npz
*.pcap
*.pcapng

# ---------------------------------------------------------------- papers / vendor docs
# (copyrighted, and large - keep locally, cite in README)
Papers/
Papers.zip
*.pdf

# ---------------------------------------------------------------- Questa / ModelSim / iverilog
sim/*/out/
sim/work*/
transcript
*.wlf
*.vcd
*.vvp
sim/*.log
modelsim.ini

# ---------------------------------------------------------------- Quartus (anywhere)
# Private repo: keep the human-readable REPORTS (*.rpt, *.summary, *.pin, logs).
# Ignore only heavy build artifacts: databases and programming binaries.
db/
incremental_db/
simulation/
greybox_tmp/
.qsys_edit/
*.qws
*.sopcinfo
*.BAK.*
*.before_*
c5_pin_model_dump.txt
hps_sdram_p0_summary.csv
*.qarlog
# programming binaries (any output_files/) - build artifacts, not reports
*.sof
*.rbf
*.pof
*.jam
*.jbc
*.jdi
*.sld
# Platform Designer output (regenerated by fpga/cv96_snn/build.sh)
fpga/cv96_snn/QSYS/CV96_QSYS/

# ---------------------------------------------------------------- Tang Nano 9K open flow
fpga/tang9k/*.json
fpga/tang9k/*.fs

# ---------------------------------------------------------------- ASIC
# keep synthesis/P&R reports AND synthesized netlists (*.v / *.vgenus);
# ignore only non-netlist heavy derived data, databases and layout binaries
asic/out/**/*.def
asic/out/**/*.gds
asic/out/**/*.sdf
asic/out/**/*.spef
asic/openlane/*/runs/
*.enc
*.enc.dat/
fv/
genus.cmd*
innovus.cmd*
# Xcelium / SimVision
xcelium.d/
INCA_libs/
*.shm/
xrun.history
xrun*.log
xrun.key
.simvision/
waves.shm/

# ---------------------------------------------------------------- Linux build products
sw/cv96/kmod/.kbuild/
sw/cv96/kmod/.xtc/
*.o
*.ko
*.mod
*.mod.c
.*.cmd
modules.order
Module.symvers
sw/cv96/tools/snn_fwctl
sw/cv96/tools/snn_test
sw/cv96/tools/vectors.h
sw/cv96/tools/cosim/obj_dir/
sw/cv96/tools/cosim/build.log

